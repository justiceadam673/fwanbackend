# ===== FWAN backend configuration. Copy to .env and fill in. Never commit .env =====
NODE_ENV=development
PORT=5000

# --- Database (online mode) ---
MONGODB_URI=mongodb://127.0.0.1:27017/fwan
# If MongoDB cannot be reached, use the offline file database instead of crashing (handy for demos)
DB_FALLBACK_TO_FILE=false

# --- Security ---
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-48-characters-or-more
JWT_EXPIRES_IN=7d
# Comma-separated list of front-end addresses allowed to call this API
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:5173
# Set true behind Render/Railway/Nginx so rate limiting sees real client IPs
TRUST_PROXY=false
# Public address of this backend (used in uploaded image URLs). Leave empty for auto.

# --- Accounts and email verification ---
# false = NO email verification: anyone can sign up and sign in immediately (no email is sent). true = require it.
REQUIRE_EMAIL_VERIFICATION=false
# false = users must click the emailed link before signing in (like Firebase). true = skip (demos only).
AUTO_VERIFY_EMAIL=false
# Public address of THIS backend: the links in emails point here (e.g. https://fwanbackend.onrender.com)
PUBLIC_URL=
# How emails are verified:
#   email    = Express sends the link (needs a provider below)
#   firebase = Firebase sends the link; Express asks Google if it is verified (needs FIREBASE_API_KEY, no provider needed)
#   both     = either works
VERIFICATION_METHOD=email
# The "apiKey" value from your React app's Firebase config (same Firebase project). It is a public key.
FIREBASE_API_KEY=
# Secret for bulk-importing Firebase accounts (long random string; leave empty to disable the endpoint)
MIGRATION_SECRET=
# --- Email provider (pick ONE; Brevo recommended: works on Render free tier and needs no domain) ---
# Brevo: create a free account, verify your sender email, create an API key (SMTP & API -> API keys)
BREVO_API_KEY=
# Or Resend (needs a verified domain to email other people): RESEND_API_KEY=
RESEND_API_KEY=
# Or classic SMTP (works locally; Render free blocks SMTP ports): SMTP_URL=smtps://user:pass@smtp.example.com:465
SMTP_URL=
# The sender must be the address you verified with the provider
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=FWAN
# After this person registers and verifies, they become admin
ADMIN_EMAIL=

# --- Payments ---
# paystack = real Paystack (needs the SECRET key, which stays ONLY on the server)
# mock     = simulated payments for demos
PAYMENT_MODE=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=

# --- Misc ---
SIM_TRIP_SECONDS=90
